{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pi-dl",
  "version": "0.1.0",
  "identifier": "com.pidl.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "pi-dl",
        "width": 900,
        "height": 620,
        "minWidth": 500,
        "minHeight": 400,
        "center": true,
        "decorations": false,
        "shadow": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.mytools/pi-body/pi-windows-x64/**/*": "pi-windows-x64"
    }
  }
}