{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Pi 扩展组件默认推荐配置映射表 (打包时通过 include_str! 内嵌至二进制 exe)",
  "presets": [
    {
      "id": "pi-web-access",
      "packageNames": [
        "pi-web-access",
        "npm:pi-web-access"
      ],
      "title": "静默后台自动摘要",
      "description": "配置全后台静默搜索与大模型自动摘要，禁止自动弹出浏览器网页夺取焦点",
      "configFile": "~/.pi/web-search.json",
      "settings": {
        "workflow": "auto-summary",
        "autoOpenBrowser": false
      }
    }
  ]
}
